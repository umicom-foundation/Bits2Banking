# Check route sources and their MkDocs directory-index destinations.
# Source inspection does not qualify a website, browser or teaching outcome.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED REPOSITORY_ROOT)
    get_filename_component(REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
file(READ "${REPOSITORY_ROOT}/knowledge/registries/learning-paths.json" _registry)
file(READ "${REPOSITORY_ROOT}/content/courses/learning-paths.html" _html)
file(READ "${REPOSITORY_ROOT}/content/start/systems-learning.md" _markdown)
file(READ "${REPOSITORY_ROOT}/mkdocs.yml" _config)
if(_config MATCHES "use_directory_urls:[ \t]*(false|False|FALSE)")
    message(FATAL_ERROR "Review learning links when changing directory-index publication URLs.")
endif()
function(require_text text needle description)
    string(FIND "${text}" "${needle}" _found)
    if(_found EQUAL -1)
        message(FATAL_ERROR "Missing ${description}: ${needle}")
    endif()
endfunction()
function(require_source relative)
    if(NOT relative MATCHES "^content/[a-z0-9/_-]+\\.(md|html)$" OR relative MATCHES "//")
        message(FATAL_ERROR "Unsafe learning source: ${relative}")
    endif()
    if(NOT EXISTS "${REPOSITORY_ROOT}/${relative}" OR IS_DIRECTORY "${REPOSITORY_ROOT}/${relative}")
        message(FATAL_ERROR "Missing learning source: ${relative}")
    endif()
endfunction()
string(JSON _routes LENGTH "${_registry}" routes)
if(_routes LESS 1)
    message(FATAL_ERROR "No learning routes were registered")
endif()
math(EXPR _last_route "${_routes} - 1")
set(_ids "")
foreach(_r RANGE 0 ${_last_route})
    string(JSON _id GET "${_registry}" routes ${_r} id)
    if(NOT _id MATCHES "^[a-z][a-z0-9-]*$" OR _id IN_LIST _ids)
        message(FATAL_ERROR "Invalid or duplicate route identifier: ${_id}")
    endif()
    list(APPEND _ids "${_id}")
    require_text("${_html}" "id=\"${_id}\"" "route section")
    string(JSON _count LENGTH "${_registry}" routes ${_r} steps)
    if(_count LESS 1)
        message(FATAL_ERROR "Empty learning route: ${_id}")
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_n RANGE 0 ${_last})
        string(JSON _source GET "${_registry}" routes ${_r} steps ${_n} source)
        require_source("${_source}")
        file(RELATIVE_PATH _relative "${REPOSITORY_ROOT}/content/courses" "${REPOSITORY_ROOT}/${_source}")
        if(_source MATCHES "\\.md$")
            if(_source MATCHES "/index\\.md$")
                string(REGEX REPLACE "\\.md$" ".html" _url "${_relative}")
            else()
                string(REGEX REPLACE "\\.md$" "/index.html" _url "${_relative}")
            endif()
            require_text("${_html}" "href=\"${_url}\" data-lesson-source=\"${_source}\"" "published lesson link and manuscript identity")
        else()
            set(_url "${_relative}")
            require_text("${_html}" "href=\"${_url}\"" "course link")
        endif()
        file(RELATIVE_PATH _md_relative "${REPOSITORY_ROOT}/content/start" "${REPOSITORY_ROOT}/${_source}")
        require_text("${_markdown}" "](${_md_relative})" "written map link")
        if(DEFINED SITE_ROOT)
            get_filename_component(_output "${SITE_ROOT}/courses/${_url}" ABSOLUTE)
            if(NOT EXISTS "${_output}" OR IS_DIRECTORY "${_output}")
                message(FATAL_ERROR "Published learning route is missing: ${_output}")
            endif()
        endif()
    endforeach()
endforeach()
string(JSON _bridges LENGTH "${_registry}" bridges)
if(_bridges LESS 1)
    message(FATAL_ERROR "No reciprocal chapter links were registered")
endif()
math(EXPR _last_bridge "${_bridges} - 1")
foreach(_b RANGE 0 ${_last_bridge})
    string(JSON _source GET "${_registry}" bridges ${_b} source)
    string(JSON _target GET "${_registry}" bridges ${_b} target)
    require_source("${_source}")
    require_source("${_target}")
    get_filename_component(_folder "${REPOSITORY_ROOT}/${_source}" DIRECTORY)
    file(RELATIVE_PATH _target_relative "${_folder}" "${REPOSITORY_ROOT}/${_target}")
    file(READ "${REPOSITORY_ROOT}/${_source}" _text)
    require_text("${_text}" "](${_target_relative})" "reciprocal chapter link")
endforeach()
set(_beginner "content/courses/computing-from-the-beginning")
file(READ "${REPOSITORY_ROOT}/${_beginner}/course.json" _course)
file(READ "${REPOSITORY_ROOT}/${_beginner}/index.html" _index)
string(JSON _count LENGTH "${_course}" lessons)
if(NOT _count EQUAL 8)
    message(FATAL_ERROR "Review the foundation syllabus and gate when adding a lesson")
endif()
foreach(_n RANGE 0 7)
    string(JSON _lesson GET "${_course}" lessons ${_n} path)
    string(JSON _manuscript GET "${_course}" lessons ${_n} manuscript)
    require_source("${_beginner}/${_lesson}")
    get_filename_component(_manuscript_path "${REPOSITORY_ROOT}/${_beginner}/${_manuscript}" ABSOLUTE)
    file(RELATIVE_PATH _source "${REPOSITORY_ROOT}" "${_manuscript_path}")
    require_source("${_source}")
    file(READ "${REPOSITORY_ROOT}/${_beginner}/${_lesson}" _page)
    require_text("${_index}" "href=\"${_lesson}\"" "lesson in contents")
    require_text("${_page}" "href=\"../index.html\"" "return to contents")
    require_text("${_page}" "href=\"../glossary.html\"" "word explanations")
    require_text("${_page}" "<details>" "explained self-check")
    require_text("${_page}" "id=\"main\"" "skip-link destination")
    if(_n GREATER 0)
        math(EXPR _previous "${_n} - 1")
        string(JSON _previous_path GET "${_course}" lessons ${_previous} path)
        get_filename_component(_previous_name "${_previous_path}" NAME)
        require_text("${_page}" "rel=\"prev\" href=\"${_previous_name}\"" "previous lesson")
    endif()
    if(_n LESS 7)
        math(EXPR _next "${_n} + 1")
        string(JSON _next_path GET "${_course}" lessons ${_next} path)
        get_filename_component(_next_name "${_next_path}" NAME)
        require_text("${_page}" "rel=\"next\" href=\"${_next_name}\"" "next lesson")
    endif()
endforeach()
message(STATUS "Learning route structure checked; browser and teaching review are separate.")
