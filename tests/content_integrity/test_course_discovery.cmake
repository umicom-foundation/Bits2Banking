cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/course_discovery.cmake")
set(_cases valid nested quoted-navigation comment-only title-only trailing-comment
    other-section missing-mapping duplicate-mapping wrong-mapping missing-html
    missing-manuscript wrong-depth escaping-manuscript duplicate-lesson
    shared-manuscript malformed-metadata sibling-course duplicate-normalized escaping-html registry-object course-object)
if(NOT DEFINED CASE OR NOT CASE IN_LIST _cases OR
   NOT DEFINED FIXTURE_ROOT OR NOT IS_ABSOLUTE "${FIXTURE_ROOT}")
    message(FATAL_ERROR "Choose a registered CASE and an absolute build-owned FIXTURE_ROOT")
endif()
# Each run owns a fresh child directory. Preserve fixtures for diagnosis; never
# remove a caller-selected tree to make a repeated test start clean.
file(MAKE_DIRECTORY "${FIXTURE_ROOT}")
file(REAL_PATH "${FIXTURE_ROOT}" _parent)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _nonce)
set(_root "${_parent}/${CASE}-${_nonce}")
if(EXISTS "${_root}")
    message(FATAL_ERROR "Fixture collision: ${_root}")
endif()
set(_course "demo")
set(_manuscript "../../lessons/demo/a.md")
if(CASE STREQUAL "nested" OR CASE STREQUAL "wrong-depth")
    set(_course "family/demo")
    if(CASE STREQUAL "nested")
        set(_manuscript "../../../lessons/demo/a.md")
    endif()
endif()
file(MAKE_DIRECTORY "${_root}/content/courses/${_course}/lessons"
    "${_root}/content/lessons/demo" "${_root}/knowledge/registries")
set(_html_relative "lessons/a.html")
set(_html "content/courses/${_course}/lessons/a.html")
if(CASE STREQUAL "sibling-course")
    set(_html "content/courses/sibling/lessons/a.html")
    set(_html_relative "../sibling/lessons/a.html")
    file(MAKE_DIRECTORY "${_root}/content/courses/sibling/lessons")
endif()
set(_md "content/lessons/demo/a.md")
if(NOT CASE STREQUAL "missing-html")
    file(WRITE "${_root}/${_html}" "<!doctype html><html lang=\"en\"><title>A</title><h1>A</h1></html>")
endif()
if(NOT CASE STREQUAL "missing-manuscript")
    file(WRITE "${_root}/${_md}" "# A\n")
endif()
set(_entry "{\"html\":\"${_html}\",\"markdown\":\"${_md}\"}")
set(_entries "${_entry}")
set(_lesson "{\"path\":\"${_html_relative}\",\"manuscript\":\"${_manuscript}\"}")
set(_lessons "${_lesson}")
set(_navigation "nav:\n  - \"Course\":\n      - \"A\": lessons/demo/a.md\n")
set(_expected "")
set(_expected_count 1)
if(CASE STREQUAL "quoted-navigation")
    set(_navigation "nav:\n  - \"A: \\\"quoted\\\" # label\": \"lessons/demo/a.md\" # allowed note\n")
elseif(CASE STREQUAL "comment-only")
    set(_navigation "nav:\n  # - \"A\": lessons/demo/a.md\n")
    set(_expected "navigation_missing:")
elseif(CASE STREQUAL "title-only")
    set(_navigation "nav:\n  - \"lessons/demo/a.md\": lessons/demo/other.md\n")
    set(_expected "navigation_missing:")
elseif(CASE STREQUAL "trailing-comment")
    set(_navigation "nav:\n  - \"Other\": lessons/demo/other.md # missing: lessons/demo/a.md\n")
    set(_expected "navigation_missing:")
elseif(CASE STREQUAL "other-section")
    set(_navigation "nav:\n  - \"Other\": lessons/demo/other.md\nextra:\n  - \"A\": lessons/demo/a.md\n")
    set(_expected "navigation_missing:")
elseif(CASE STREQUAL "missing-mapping")
    set(_entries "{\"html\":\"content/courses/demo/lessons/other.html\",\"markdown\":\"${_md}\"}")
    set(_expected "edition_missing:")
elseif(CASE STREQUAL "duplicate-mapping")
    set(_entries "${_entry},${_entry}")
    set(_expected "edition_duplicate:")
elseif(CASE STREQUAL "wrong-mapping")
    set(_entries "{\"html\":\"${_html}\",\"markdown\":\"content/lessons/demo/other.md\"}")
    set(_expected "edition_missing:")
elseif(CASE STREQUAL "missing-html" OR CASE STREQUAL "missing-manuscript" OR CASE STREQUAL "wrong-depth")
    set(_expected "source_missing:")
elseif(CASE STREQUAL "escaping-manuscript")
    file(WRITE "${_root}/outside.md" "# Outside the content boundary\n")
    set(_lessons "{\"path\":\"lessons/a.html\",\"manuscript\":\"../../../outside.md\"}")
    set(_expected "source_outside:")
elseif(CASE STREQUAL "duplicate-lesson")
    set(_lessons "${_lesson},${_lesson}")
    set(_expected "course_duplicate:")
elseif(CASE STREQUAL "duplicate-normalized")
    set(_lessons "${_lesson},{\"path\":\"lessons/./a.html\",\"manuscript\":\"${_manuscript}\"}")
    set(_expected "course_duplicate:")
elseif(CASE STREQUAL "escaping-html")
    file(WRITE "${_root}/outside.html" "<h1>Outside the content boundary</h1>")
    set(_lessons "{\"path\":\"../../../outside.html\",\"manuscript\":\"${_manuscript}\"}")
    set(_expected "source_outside:")
elseif(CASE STREQUAL "shared-manuscript")
    file(WRITE "${_root}/content/courses/${_course}/lessons/b.html" "<h1>Another edition</h1>")
    set(_entries "${_entry},{\"html\":\"content/courses/${_course}/lessons/b.html\",\"markdown\":\"${_md}\"}")
    set(_lessons "${_lesson},{\"path\":\"lessons/b.html\",\"manuscript\":\"${_manuscript}\"}")
    set(_expected_count 2)
elseif(CASE STREQUAL "registry-object")
    set(_expected "registry:")
elseif(CASE STREQUAL "course-object")
    set(_expected "course:")
elseif(CASE STREQUAL "malformed-metadata")
    set(_expected "course:")
endif()
file(WRITE "${_root}/knowledge/registries/lesson-media.json" "{\"lessons\":[${_entries}]}")
if(CASE STREQUAL "registry-object")
    file(WRITE "${_root}/knowledge/registries/lesson-media.json" "{\"lessons\":{\"a\":${_entry}}}")
endif()
file(WRITE "${_root}/mkdocs.yml" "${_navigation}")
if(CASE STREQUAL "malformed-metadata")
    file(WRITE "${_root}/content/courses/${_course}/course.json" "{")
elseif(CASE STREQUAL "course-object")
    file(WRITE "${_root}/content/courses/${_course}/course.json" "{\"lessons\":{\"a\":${_lesson}}}")
else()
    file(WRITE "${_root}/content/courses/${_course}/course.json" "{\"lessons\":[${_lessons}]}")
endif()
CheckCourseDiscovery("${_root}" _error _count)
if(_expected STREQUAL "")
    if(NOT _error STREQUAL "" OR NOT _count EQUAL _expected_count)
        message(FATAL_ERROR "${CASE}: expected ${_expected_count} pairs; got ${_count}, ${_error}")
    endif()
else()
    string(FIND "${_error}" "${_expected}" _prefix)
    if(NOT _prefix EQUAL 0 OR NOT _count EQUAL 0)
        message(FATAL_ERROR "${CASE}: expected ${_expected} with no published count; got ${_error}, ${_count}")
    endif()
endif()
message(STATUS "Course discovery fixture ${CASE} completed; evidence at ${_root}")
