if(NOT DEFINED CASE OR NOT DEFINED FIXTURE_ROOT)
    message(FATAL_ERROR "CASE and FIXTURE_ROOT are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/source_reference.cmake")
file(MAKE_DIRECTORY "${FIXTURE_ROOT}/labs/sample")
file(WRITE "${FIXTURE_ROOT}/labs/sample/main.c" "fixture source identity; never compiled\n")
if(CASE STREQUAL "local")
    set(source "labs/sample/main.c")
    set(expected TRUE)
elseif(CASE STREQUAL "local-missing")
    set(source "labs/sample/missing.c")
    set(expected FALSE)
elseif(CASE STREQUAL "local-directory")
    set(source "labs/sample")
    set(expected FALSE)
elseif(CASE STREQUAL "compiler-relative")
    set(source "umicom-c/src/vm.c")
    set(expected TRUE)
elseif(CASE STREQUAL "compiler-sibling")
    set(source "../umicom-c/include/umicom_c/trace.h")
    set(expected TRUE)
elseif(CASE STREQUAL "kernel-sibling")
    set(source "../umicom-kernel/programs/cvm/main.c")
    set(expected TRUE)
elseif(CASE STREQUAL "framework-sibling")
    set(source "../Umicom-Applications/framework/src/toolchain/cvm_preview.c")
    set(expected TRUE)
elseif(CASE STREQUAL "compiler-public")
    set(source "https://github.com/umicom-foundation/umicom-c/blob/main/tests/test_trace.c")
    set(expected TRUE)
elseif(CASE STREQUAL "framework-public")
    set(source "https://github.com/umicom-foundation/umicom-framework/blob/main/include/umicom/toolchain/cvm_trace.h")
    set(expected TRUE)
elseif(CASE STREQUAL "kernel-public")
    set(source "https://github.com/umicom-foundation/umicom-kernel/blob/main/programs/cvm/main.c")
    set(expected TRUE)
elseif(CASE STREQUAL "studio-public")
    set(source "https://github.com/umicom-foundation/umicom-studio-ide-module/blob/main/src/main.c")
    set(expected TRUE)
elseif(CASE STREQUAL "os-public")
    set(source "https://github.com/umicom-foundation/umicom-os/blob/main/boot/cvm-probe/main.c")
    set(expected TRUE)
elseif(CASE STREQUAL "unapproved-repository")
    set(source "https://github.com/another/project/blob/main/src/main.c")
    set(expected FALSE)
elseif(CASE STREQUAL "branch-change")
    set(source "https://github.com/umicom-foundation/umicom-c/blob/other/src/vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "query")
    set(source "https://github.com/umicom-foundation/umicom-c/blob/main/src/vm.c?raw=1")
    set(expected FALSE)
elseif(CASE STREQUAL "fragment")
    set(source "umicom-c/src/vm.c#L1")
    set(expected FALSE)
elseif(CASE STREQUAL "empty-segment")
    set(source "umicom-c/src//vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "dot-segment")
    set(source "umicom-c/src/./vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "parent-segment")
    set(source "umicom-c/src/../vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "extra-parent")
    set(source "../../umicom-c/src/vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "absolute")
    set(source "C:/umicom-c/src/vm.c")
    set(expected FALSE)
elseif(CASE STREQUAL "encoded")
    set(source "umicom-c/src/%76m.c")
    set(expected FALSE)
elseif(CASE STREQUAL "trailing-slash")
    set(source "umicom-c/src/")
    set(expected FALSE)
elseif(CASE STREQUAL "local-traversal")
    set(source "labs/../README.md")
    set(expected FALSE)
elseif(CASE STREQUAL "empty")
    set(source "")
    set(expected FALSE)
else()
    message(FATAL_ERROR "Unknown source reference case")
endif()
BtbValidateSourceReference("${source}" "${FIXTURE_ROOT}" valid reason)
if(expected AND NOT valid)
    message(FATAL_ERROR "Valid source identity refused: ${source}: ${reason}")
elseif(NOT expected AND valid)
    message(FATAL_ERROR "Invalid source identity accepted: ${source}")
elseif(NOT expected AND reason STREQUAL "")
    message(FATAL_ERROR "Refusal lacks an explanation")
endif()
