cmake_minimum_required(VERSION 3.24)
include_guard(GLOBAL)

# Course paths may climb from nested metadata but must name existing files in
# the declared subtree. Physical containment also refuses symlink escapes.
function(CourseDiscoveryFile base relative subtree out_path out_error)
    set(${out_path} "" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
    if(IS_ABSOLUTE "${relative}" OR NOT relative MATCHES "^[A-Za-z0-9_./-]+$")
        set(${out_error} "source_path: invalid relative path ${relative}" PARENT_SCOPE)
        return()
    endif()
    cmake_path(ABSOLUTE_PATH relative BASE_DIRECTORY "${base}" NORMALIZE OUTPUT_VARIABLE _target)
    if(NOT EXISTS "${_target}" OR IS_DIRECTORY "${_target}")
        set(${out_error} "source_missing: ${relative}" PARENT_SCOPE)
        return()
    endif()
    file(REAL_PATH "${subtree}" _subtree)
    file(REAL_PATH "${_target}" _actual)
    cmake_path(IS_PREFIX _subtree "${_actual}" NORMALIZE _inside)
    if(NOT _inside)
        set(${out_error} "source_outside: ${relative}" PARENT_SCOPE)
        return()
    endif()
    set(${out_path} "${_actual}" PARENT_SCOPE)
endfunction()

# Admit the repository's block navigation style, without implementing YAML
# rendering. Comments, titles and other configuration sections are not routes.
# Labels may be quoted; only the destination scalar is collected.
function(CourseDiscoveryNavigation text out_paths)
    string(REPLACE "\r\n" "\n" _text "${text}")
    string(REPLACE ";" "\\;" _text "${_text}")
    string(REPLACE "\n" ";" _lines "${_text}")
    set(_active FALSE)
    set(_paths)
    set(_label [=[^[ \t]*-[ \t]+("(\\.|[^"\\])*"|'(''|[^'])*'|[^:#"']+):[ \t]*]=])
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^nav:[ \t]*(#.*)?$")
            set(_active TRUE)
            continue()
        endif()
        if(_active AND _line MATCHES "^[A-Za-z_][A-Za-z0-9_-]*:")
            set(_active FALSE)
        endif()
        if(NOT _active OR NOT _line MATCHES "${_label}")
            continue()
        endif()
        string(REGEX REPLACE "${_label}" "" _value "${_line}")
        set(_path "")
        if(_value MATCHES "^\"([A-Za-z0-9_./-]+[.]md)\"[ \t]*(#.*)?$")
            set(_path "${CMAKE_MATCH_1}")
        elseif(_value MATCHES "^'([A-Za-z0-9_./-]+[.]md)'[ \t]*(#.*)?$")
            set(_path "${CMAKE_MATCH_1}")
        elseif(_value MATCHES "^([A-Za-z0-9_./-]+[.]md)[ \t]*(#.*)?$")
            set(_path "${CMAKE_MATCH_1}")
        endif()
        if(NOT _path STREQUAL "")
            list(APPEND _paths "${_path}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _paths)
    set(${out_paths} "${_paths}" PARENT_SCOPE)
endfunction()

# Return the first diagnostic; publish a count only on success. Existing aliases
# may share a manuscript, but one HTML identity must have one edition mapping.
function(CheckCourseDiscovery root out_error out_count)
    set(${out_error} "" PARENT_SCOPE)
    set(${out_count} 0 PARENT_SCOPE)
    if(NOT IS_DIRECTORY "${root}/content/courses" OR
       NOT EXISTS "${root}/knowledge/registries/lesson-media.json" OR
       NOT EXISTS "${root}/mkdocs.yml")
        set(${out_error} "repository: missing content, edition registry or navigation" PARENT_SCOPE)
        return()
    endif()
    file(REAL_PATH "${root}" _root)
    file(READ "${_root}/knowledge/registries/lesson-media.json" _registry)
    string(JSON _entry_type ERROR_VARIABLE _type_error TYPE "${_registry}" lessons)
    string(JSON _entries ERROR_VARIABLE _error LENGTH "${_registry}" lessons)
    if(NOT _error STREQUAL "NOTFOUND" OR NOT _type_error STREQUAL "NOTFOUND" OR
       NOT _entry_type STREQUAL "ARRAY" OR _entries LESS 1)
        set(${out_error} "registry: invalid or empty lesson list" PARENT_SCOPE)
        return()
    endif()
    math(EXPR _last "${_entries} - 1")
    foreach(_i RANGE 0 ${_last})
        string(JSON _entry GET "${_registry}" lessons ${_i})
        string(JSON _html ERROR_VARIABLE _html_error GET "${_entry}" html)
        string(JSON _markdown ERROR_VARIABLE _md_error GET "${_entry}" markdown)
        if(NOT _html_error STREQUAL "NOTFOUND" OR NOT _md_error STREQUAL "NOTFOUND" OR
           NOT _html MATCHES "^content/courses/[A-Za-z0-9_./-]+[.]html$" OR
           NOT _markdown MATCHES "^content/lessons/[A-Za-z0-9_./-]+[.]md$")
            set(${out_error} "registry: malformed edition at ${_i}" PARENT_SCOPE)
            return()
        endif()
        cmake_path(NORMAL_PATH _html OUTPUT_VARIABLE _normal_html)
        cmake_path(NORMAL_PATH _markdown OUTPUT_VARIABLE _normal_md)
        if(NOT _html STREQUAL _normal_html OR NOT _markdown STREQUAL _normal_md)
            set(${out_error} "registry: non-canonical path at ${_i}" PARENT_SCOPE)
            return()
        endif()
        string(SHA256 _key "${_html}")
        if(DEFINED _edition_${_key})
            set(${out_error} "edition_duplicate: ${_html}" PARENT_SCOPE)
            return()
        endif()
        set(_edition_${_key} "${_markdown}")
    endforeach()
    file(READ "${_root}/mkdocs.yml" _navigation)
    CourseDiscoveryNavigation("${_navigation}" _nav_paths)
    file(GLOB_RECURSE _json_files LIST_DIRECTORIES FALSE "${_root}/content/courses/*.json")
    set(_courses 0)
    set(_lessons 0)
    foreach(_metadata IN LISTS _json_files)
        get_filename_component(_name "${_metadata}" NAME)
        if(NOT _name STREQUAL "course.json")
            continue()
        endif()
        math(EXPR _courses "${_courses} + 1")
        file(REAL_PATH "${_metadata}" _actual_metadata)
        set(_course_root "${_root}/content/courses")
        cmake_path(IS_PREFIX _course_root "${_actual_metadata}" NORMALIZE _inside)
        if(NOT _inside)
            set(${out_error} "source_outside: ${_metadata}" PARENT_SCOPE)
            return()
        endif()
        file(READ "${_metadata}" _course)
        string(JSON _lesson_type ERROR_VARIABLE _type_error TYPE "${_course}" lessons)
        string(JSON _count ERROR_VARIABLE _error LENGTH "${_course}" lessons)
        if(NOT _error STREQUAL "NOTFOUND" OR NOT _type_error STREQUAL "NOTFOUND" OR
           NOT _lesson_type STREQUAL "ARRAY" OR _count LESS 1)
            set(${out_error} "course: invalid or empty lesson list in ${_metadata}" PARENT_SCOPE)
            return()
        endif()
        get_filename_component(_base "${_metadata}" DIRECTORY)
        math(EXPR _last_lesson "${_count} - 1")
        set(_seen)
        foreach(_i RANGE 0 ${_last_lesson})
            string(JSON _lesson GET "${_course}" lessons ${_i})
            string(JSON _relative ERROR_VARIABLE _html_error GET "${_lesson}" path)
            string(JSON _manuscript ERROR_VARIABLE _md_error GET "${_lesson}" manuscript)
            # Existing introductory courses deliberately reference a sibling course.
            # Retain the first local-only rule for review; the active rule below
            # relies on canonical physical containment and resolved identity instead.
            if(FALSE)
            if(NOT _html_error STREQUAL "NOTFOUND" OR NOT _md_error STREQUAL "NOTFOUND" OR
               NOT _relative MATCHES "^lessons/[A-Za-z0-9_.-]+[.]html$" OR
               NOT _manuscript MATCHES "[.]md$")
                set(${out_error} "course: missing or invalid paired paths in ${_metadata}" PARENT_SCOPE)
                return()
            endif()
            endif()
            if(NOT _html_error STREQUAL "NOTFOUND" OR NOT _md_error STREQUAL "NOTFOUND" OR
               NOT _relative MATCHES "[.]html$" OR
               NOT _manuscript MATCHES "[.]md$")
                set(${out_error} "course: missing or invalid paired paths in ${_metadata}" PARENT_SCOPE)
                return()
            endif()
            # Equivalent spellings must not hide duplicate lesson identities.
            # The initial spelling-only check is retained; resolved paths replace it.
            if(FALSE)
            if(_relative IN_LIST _seen)
                set(${out_error} "course_duplicate: ${_relative}" PARENT_SCOPE)
                return()
            endif()
            list(APPEND _seen "${_relative}")
            endif()
            CourseDiscoveryFile("${_base}" "${_relative}" "${_root}/content/courses" _html_file _error)
            if(_error STREQUAL "")
                CourseDiscoveryFile("${_base}" "${_manuscript}" "${_root}/content/lessons" _md_file _error)
            endif()
            if(NOT _error STREQUAL "")
                set(${out_error} "${_error}" PARENT_SCOPE)
                return()
            endif()
            if(_html_file IN_LIST _seen)
                set(${out_error} "course_duplicate: ${_relative}" PARENT_SCOPE)
                return()
            endif()
            list(APPEND _seen "${_html_file}")
            file(RELATIVE_PATH _html "${_root}" "${_html_file}")
            file(RELATIVE_PATH _markdown "${_root}" "${_md_file}")
            string(SHA256 _key "${_html}")
            if(NOT DEFINED _edition_${_key} OR NOT "${_edition_${_key}}" STREQUAL "${_markdown}")
                set(${out_error} "edition_missing: ${_html}" PARENT_SCOPE)
                return()
            endif()
            file(RELATIVE_PATH _published "${_root}/content" "${_md_file}")
            if(NOT _published IN_LIST _nav_paths)
                set(${out_error} "navigation_missing: ${_published}" PARENT_SCOPE)
                return()
            endif()
            math(EXPR _lessons "${_lessons} + 1")
        endforeach()
    endforeach()
    if(_courses LESS 1)
        set(${out_error} "course: no course metadata found" PARENT_SCOPE)
        return()
    endif()
    set(${out_count} "${_lessons}" PARENT_SCOPE)
endfunction()
