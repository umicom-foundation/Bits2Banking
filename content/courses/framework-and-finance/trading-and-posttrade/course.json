        "lessons/17-admit-the-final-owner-revision.html",
        "lessons/18-qualify-the-client-and-product-separately.html"
      ]
    },
    {
      "id": "local-policy-observations",
      "title": "Capabilities, denied observations and exact identity display",
      "description": "Distinguish request vocabulary from implemented local behavior, observe refusal without order creation and display full-width identities through Framework.",
      "lessons": [
        "lessons/19-separate-validity-from-capability.html",
        "lessons/20-observe-denial-without-an-order.html",
        "lessons/21-display-revision-digits-exactly.html"
      ]
    },
    {
      "id": "market-observation-laboratory",
      "title": "Build a market-observation client with shared owners",
      "description": "Validate market depth, distinguish public prints from account fills, observe alerts and protective controls, and handle refusals through a thin C23 SDK client.",
      "lessons": [
        "lessons/22-own-a-market-observation-client.html",
        "lessons/23-validate-depth-before-lookup.html",
        "lessons/24-observe-public-prints-without-fills.html",
        "lessons/25-publish-alert-changes-together.html",
        "lessons/26-preserve-protective-actions-and-status.html",
        "lessons/27-handle-refusal-without-resetting-owners.html"
      ]
    },
    {
      "id": "identity-and-navigation-lifetime",
      "title": "Keep identities, outputs and chart views attached to their owners",
      "description": "Use bounded watchlist admission, fixed-window attempts and instrument-associated navigation through an installed C23 client.",
      "lessons": [
        "lessons/28-distinguish-identity-from-array-position.html",
        "lessons/29-bound-queries-and-protect-output.html",
        "lessons/30-admit-every-active-record.html",
        "lessons/31-treat-zero-as-a-real-timestamp.html",
