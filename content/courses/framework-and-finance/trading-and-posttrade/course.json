        "lessons/09-test-failure-without-mutation.html",
        "lessons/10-connect-a-trading-command-to-framework.html"
      ]
    },
    {
      "id": "execution-ownership-laboratory",
      "title": "Laboratory: fills, replay and cancellation through one workspace",
      "description": "Extend the local order example into a thin C23 client of the canonical workspace. Trace ownership, identities, atomic publication, replay, partial cancellation and represented quantity boundaries.",
      "lessons": [
        "lessons/11-own-a-workspace-execution-session.html",
        "lessons/12-separate-order-and-execution-identities.html",
        "lessons/13-publish-fill-state-together.html",
