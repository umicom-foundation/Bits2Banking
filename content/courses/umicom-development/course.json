  "foundationCourse": "../learning-computer-architecture/index.html",
  "learningPath": "../learning-paths.html",
  "prerequisites": [
    "Complete Learning C through arrays, structures, pointers and separate source files. Learn the difference between an editor and a compiler before starting the practical project."
  ],
  "modules": [
    {
      "id": "first-application",
      "title": "First application: one example from source to a window",
      "description": "After Learning C, follow the exercise counter through its Framework interface, build description, console and GTK4 window. The C introduction is a recap, not a replacement for the C course.",
      "lessons": [
        "lessons/01-introduction-to-c.html",
        "lessons/02-introduction-to-framework.html",
        "lessons/03-introduction-to-cmake.html",
        "lessons/06-use-an-installed-sdk.html",
        "lessons/04-framework-development.html",
        "lessons/05-introduction-to-gtk4.html"
      ]
    },
    {
      "id": "build-and-diagnose",
      "title": "Build, test and investigate a change",
      "description": "Use the same project to learn incremental builds, diagnostics and test commands. Continue with test data and skipped coverage after understanding a normal run.",
      "lessons": [
        "lessons/07-build-only-what-changed.html",
        "lessons/08-read-build-and-test-evidence.html",
        "lessons/09-understand-test-commands.html",
        "lessons/30-keep-test-data-separate.html",
        "lessons/31-understand-skipped-tests-and-host-coverage.html"
      ]
    },
    {
      "id": "services",
      "title": "Shared services and application lifetimes",
      "description": "Further source studies after the first application. Follow registration and inspection before asynchronous work, waiting and connection boundaries.",
      "lessons": [
        "lessons/11-register-shared-services.html",
        "lessons/12-inspect-application-services.html",
        "lessons/10-close-background-work.html",
        "lessons/28-understand-waiting-and-timeouts.html",
        "lessons/22-follow-protocol-message-boundaries.html",
        "lessons/25-validate-a-tool-connection.html"
      ]
    },
    {
      "id": "learning-reader",
      "title": "Project study: an offline learning reader",
      "description": "A separate project after shared services. Start with the reader and safe example copying, then add help, checkpoints, text and images in that order.",
      "lessons": [
        "lessons/13-build-an-offline-learning-reader.html",
        "lessons/14-copy-examples-without-overwriting.html",
        "lessons/15-connect-commands-to-guides.html",
        "lessons/21-connect-keyboard-and-button-help.html",
        "lessons/16-keep-revision-bound-checkpoints.html",
        "lessons/17-keep-reading-state-consistent.html",
        "lessons/18-store-checkpoints-on-a-worker.html",
        "lessons/19-remember-locations-without-inheriting-trust.html",
        "lessons/20-preserve-structure-when-reading-code.html",
        "lessons/23-carry-image-pixels-to-a-window.html",
        "lessons/24-find-text-with-shared-services.html",
        "lessons/26-search-verified-learning-resources.html",
        "lessons/27-open-search-results-without-losing-your-place.html"
      ]
    },
    {
      "id": "workspaces",
      "title": "Project study: application workspaces",
      "description": "After GTK4 events and shared services, study projects, panels, keyboard focus and retained work.",
      "lessons": [
        "lessons/29-remember-projects-without-deleting-files.html",
        "lessons/32-use-application-workspaces.html",
        "lessons/33-follow-keyboard-focus.html",
        "lessons/34-check-layout-and-draft-retention.html"
      ]
    },
    {
      "id": "specialist-data",
      "title": "Optional application study: calendar data",
      "description": "A trading-data example after the core development route; it is not a prerequisite for C or GTK4.",
      "lessons": [
        "lessons/35-read-calendar-data-without-inventing-values.html"
      ]
    },
    {
      "id": "shared-feature-map",
      "title": "Consolidation: map a shared feature",
      "description": "Trace the same example through its public contract, implementation, consumers and checks.",
      "lessons": [
        "lessons/36-map-a-shared-feature-before-changing-it.html"
      ]
    }
  ],
  "courseSeriesTitle": "Learning Umicom Framework",
  "nextTopics": "New shared services, documentation, SDK consumers and application integration.",
  "seriesPrerequisites": "Complete Learning C, then the First application module. The feature-map lesson is a consolidation exercise."
}
