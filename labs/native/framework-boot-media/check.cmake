# Keep the former case admission for review; cancellation is an explicit new exercise.
if(FALSE)
if(NOT CASE MATCHES "^(review|copy|exists|stale|confirmation|tamper)$")
    message(FATAL_ERROR "Unknown media exercise")
endif()
endif()
if(NOT CASE MATCHES "^(review|copy|exists|stale|confirmation|tamper|cancel-recheck|cancel-write|cancel-flush|cancel-verify|cancel-finished|bad-phase)$")
    message(FATAL_ERROR "Unknown media exercise")
endif()
if(NOT IS_ABSOLUTE "${WORK}" OR NOT EXISTS "${TOOL}" OR NOT EXISTS "${PRACTICE}")
    message(FATAL_ERROR "Built tools and an absolute scratch location are required")
endif()
# Preserve prior evidence. Each run gets a fresh directory and never removes files.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _identity)
set(_root "${WORK}/${CASE}-${_identity}")
if(EXISTS "${_root}")
    message(FATAL_ERROR "Scratch collision; preserve existing evidence")
endif()
file(MAKE_DIRECTORY "${_root}")
set(_image "${_root}/source image.img")
set(_copy "${_root}/copy image.img")
execute_process(COMMAND "${PRACTICE}" --output "${_image}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
if(NOT "${_code}" STREQUAL "0" OR NOT _out MATCHES "Not bootable")
    message(FATAL_ERROR "Practice fixture failed: ${_code}; ${_out}; ${_err}")
endif()
execute_process(COMMAND "${TOOL}" inspect "${_image}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
if(NOT "${_code}" STREQUAL "0" OR NOT _out MATCHES "Bytes: 2097152")
    message(FATAL_ERROR "Inspection failed: ${_code}; ${_out}; ${_err}")
endif()
execute_process(COMMAND "${TOOL}" review "${_image}" "${_copy}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
if(NOT "${_code}" STREQUAL "0" OR EXISTS "${_copy}")
    message(FATAL_ERROR "Review failed or created its destination: ${_code}; ${_err}")
endif()
string(REGEX MATCH "Fingerprint: ([0-9a-f]+)" _match "${_out}")
set(_fingerprint "${CMAKE_MATCH_1}")
string(LENGTH "${_fingerprint}" _length)
if(NOT _length EQUAL 64)
    message(FATAL_ERROR "Review omitted its complete fingerprint")
endif()
string(REGEX MATCH "Confirmation: ([^\r\n]+)" _match "${_out}")
set(_confirmation "${CMAKE_MATCH_1}")
if(NOT _confirmation MATCHES "^CREATE ")
    message(FATAL_ERROR "Regular-file confirmation was not returned")
endif()

# An explicit stop is different from rollback: report flags describe effects,
# and existing exercise artifacts are retained for inspection.
if(CASE MATCHES "^cancel-" OR CASE STREQUAL "bad-phase")
    string(REGEX REPLACE "^cancel-" "" _phase "${CASE}")
    if(CASE STREQUAL "bad-phase")
        set(_phase "not-a-phase")
    endif()
    execute_process(COMMAND "${TOOL}" copy-until "${_image}" "${_copy}" "${_fingerprint}" "${_confirmation}" "${_phase}"
        RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
    file(WRITE "${_root}/cancellation.txt" "Exit: ${_code}\n${_out}\n${_err}\n")
    if(CASE STREQUAL "bad-phase")
        if(NOT "${_code}" STREQUAL "2" OR EXISTS "${_copy}")
            message(FATAL_ERROR "Invalid phase started an operation: ${_code}; ${_out}; ${_err}")
        endif()
        return()
    endif()
    if(NOT "${_code}" STREQUAL "1" OR NOT _out MATCHES "Requested stop observed: 1")
        message(FATAL_ERROR "Cancellation was not observed: ${_code}; ${_out}; ${_err}")
    endif()
    if(CASE STREQUAL "cancel-recheck")
        if(EXISTS "${_copy}" OR NOT _out MATCHES "output-created=0 write-started=0 verified=0")
            message(FATAL_ERROR "Recheck cancellation acquired output: ${_out}")
        endif()
    elseif(CASE STREQUAL "cancel-write")
        if(NOT EXISTS "${_copy}" OR NOT _out MATCHES "output-created=1 write-started=0 verified=0")
            message(FATAL_ERROR "Pre-write cancellation lost creation evidence: ${_out}")
        endif()
        file(SIZE "${_copy}" _bytes)
        if(NOT _bytes EQUAL 0)
            message(FATAL_ERROR "Pre-write cancellation left payload bytes")
        endif()
    else()
        if(NOT EXISTS "${_copy}" OR NOT _out MATCHES "output-created=1 write-started=1 verified=0")
            message(FATAL_ERROR "Late cancellation changed effect meaning: ${_out}")
        endif()
        file(SHA256 "${_image}" _source_hash)
        file(SHA256 "${_copy}" _copy_hash)
        if(NOT _source_hash STREQUAL _copy_hash)
            message(FATAL_ERROR "Complete payload differs in late cancellation exercise")
        endif()
        # Independent verification is a new observation, not a rewritten transfer result.
        execute_process(COMMAND "${TOOL}" verify "${_image}" "${_copy}"
            RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
        file(WRITE "${_root}/later-verification.txt" "Exit: ${_code}\n${_out}\n${_err}\n")
        if(NOT "${_code}" STREQUAL "0" OR NOT _out MATCHES "output-created=0 write-started=0 verified=1")
            message(FATAL_ERROR "Later read-only verification failed: ${_code}; ${_out}; ${_err}")
        endif()
    endif()
    message(STATUS "Cancellation effects retained; no physical-media or boot claim")
    return()
endif()

if(CASE STREQUAL "review")
    return()
elseif(CASE STREQUAL "exists")
    file(WRITE "${_copy}" "Retain this existing document.")
    file(SHA256 "${_copy}" _original)
elseif(CASE STREQUAL "stale")
    string(REPEAT "x" 512 _sector)
    file(APPEND "${_image}" "${_sector}")
elseif(CASE STREQUAL "confirmation")
    set(_confirmation "CREATE WRONG TOKEN")
endif()
execute_process(COMMAND "${TOOL}" copy "${_image}" "${_copy}" "${_fingerprint}" "${_confirmation}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
if(CASE MATCHES "^(exists|stale|confirmation)$")
    if(NOT "${_code}" STREQUAL "1")
        message(FATAL_ERROR "Expected explicit refusal: ${_code}; ${_out}; ${_err}")
    endif()
    if(CASE STREQUAL "exists")
        file(SHA256 "${_copy}" _after)
        if(NOT _after STREQUAL _original)
            message(FATAL_ERROR "Existing destination changed")
        endif()
    elseif(EXISTS "${_copy}")
        message(FATAL_ERROR "Refused operation created a destination")
    endif()
    return()
endif()
if(NOT "${_code}" STREQUAL "0" OR NOT _out MATCHES "Copied and verified")
    message(FATAL_ERROR "Copy failed: ${_code}; ${_out}; ${_err}")
endif()
file(SHA256 "${_image}" _source_hash)
file(SHA256 "${_copy}" _copy_hash)
if(NOT _source_hash STREQUAL _copy_hash)
    message(FATAL_ERROR "Successful copy has different bytes")
endif()
set(_expected 0)
if(CASE STREQUAL "tamper")
    file(APPEND "${_copy}" "Changed after transfer")
    set(_expected 1)
endif()
execute_process(COMMAND "${TOOL}" verify "${_image}" "${_copy}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10 ENCODING UTF-8)
if(NOT "${_code}" STREQUAL "${_expected}")
    message(FATAL_ERROR "Verification: expected ${_expected}, got ${_code}; ${_out}; ${_err}")
endif()
message(STATUS "Regular-file ${CASE} contract observed; no boot or device qualification")
