# Preserve the original six inline cases for review. The active checks keep
# those outcomes and add owned-body and compatibility observations.
#[==[
if(NOT DEFINED TOOL OR NOT DEFINED ROOT OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL, ROOT and CASE are required")
endif()
set(method GET)
set(url /message.txt)
set(expected 200)
if(CASE STREQUAL "head")
    set(method HEAD)
elseif(CASE STREQUAL "nested")
    set(url /nested/note.txt)
elseif(CASE STREQUAL "missing")
    set(url /absent.txt)
    set(expected 404)
elseif(CASE STREQUAL "traversal")
    set(url /%2e%2e/message.txt)
    set(expected 403)
elseif(CASE STREQUAL "post")
    set(method POST)
    set(expected 405)
elseif(NOT CASE STREQUAL "get")
    message(FATAL_ERROR "Unknown case")
endif()
execute_process(COMMAND "${TOOL}" "${ROOT}" "${method}" "${url}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "HTTP ${expected}")
    message(FATAL_ERROR "Expected HTTP ${expected}: exit=${result}, ${output} ${error}")
endif()
if(CASE STREQUAL "get" OR CASE STREQUAL "head")
    if(NOT output MATCHES "representation-bytes: 14" OR NOT output MATCHES "48 65 6c 6c 6f")
        message(FATAL_ERROR "Wrong complete representation: ${output}")
    endif()
endif()
if(CASE STREQUAL "head")
    if(NOT output MATCHES "body-sent: no")
        message(FATAL_ERROR "HEAD unexpectedly includes a body")
    endif()
else()
    if(NOT output MATCHES "body-sent: yes")
        message(FATAL_ERROR "Non-HEAD response lost its body")
    endif()
endif()
]==]

if(NOT DEFINED TOOL OR NOT DEFINED ROOT OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL, ROOT and CASE are required")
endif()
set(method GET)
set(url /message.txt)
set(expected 200)
set(options "")
if(CASE MATCHES "^owned-")
    set(options --owned)
endif()
if(CASE STREQUAL "head" OR CASE STREQUAL "owned-head")
    set(method HEAD)
elseif(CASE STREQUAL "nested")
    set(url /nested/note.txt)
elseif(CASE STREQUAL "missing")
    set(url /absent.txt)
    set(expected 404)
elseif(CASE STREQUAL "traversal")
    set(url /%2e%2e/message.txt)
    set(expected 403)
elseif(CASE STREQUAL "post")
    set(method POST)
    set(expected 405)
elseif(CASE STREQUAL "owned-svg" OR CASE STREQUAL "legacy-svg")
    set(url /umicom-logo.svg)
    set(expected_type "image/svg+xml")
    if(CASE STREQUAL "legacy-svg")
        set(expected 413)
    endif()
elseif(CASE STREQUAL "owned-ico")
    set(url /umicom.ico)
    set(expected_type "image/vnd.microsoft.icon")
elseif(NOT CASE STREQUAL "get" AND NOT CASE STREQUAL "owned-get")
    message(FATAL_ERROR "Unknown case")
endif()
execute_process(COMMAND "${TOOL}" "${ROOT}" "${method}" "${url}" ${options}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10 ENCODING UTF-8)
# Normalize captured text only; asset bytes remain untouched.
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "HTTP ${expected}")
    message(FATAL_ERROR "Expected HTTP ${expected}: exit=${result}, ${output} ${error}")
endif()
if(CASE MATCHES "^(get|head|owned-get|owned-head)$")
    if(NOT output MATCHES "representation-bytes: 14" OR NOT output MATCHES "48 65 6c 6c 6f")
        message(FATAL_ERROR "Wrong complete text representation: ${output}")
    endif()
elseif(CASE MATCHES "^owned-(svg|ico)$")
    file(SIZE "${ROOT}${url}" expected_size)
    if(expected_size LESS 16384 OR expected_size GREATER 1048576)
        message(FATAL_ERROR "Canonical asset no longer exercises the large bounded-body range")
    endif()
    string(FIND "${output}" "representation-bytes: ${expected_size}\n" size_match)
    string(FIND "${output}" "Content-Type: ${expected_type}\n" type_match)
    if(size_match EQUAL -1 OR type_match EQUAL -1)
        message(FATAL_ERROR "Wrong asset length or MIME type: ${output}")
    endif()
    file(READ "${ROOT}${url}" prefix LIMIT 32 HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" " \\1" prefix "${prefix}")
    string(FIND "${output}" "first-bytes:${prefix}" prefix_match)
    if(prefix_match EQUAL -1)
        message(FATAL_ERROR "Wrong copied asset prefix: ${output}")
    endif()
endif()
if(method STREQUAL "HEAD")
    if(NOT output MATCHES "body-sent: no")
        message(FATAL_ERROR "HEAD unexpectedly includes a planned body")
    endif()
elseif(NOT output MATCHES "body-sent: yes")
    message(FATAL_ERROR "Non-HEAD response lost its planned body")
endif()
if(NOT output MATCHES "transport: inspection only")
    message(FATAL_ERROR "The lab must identify its non-network boundary")
endif()
