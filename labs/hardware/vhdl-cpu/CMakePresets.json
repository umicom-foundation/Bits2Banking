{
  "version": 6,
  "configurePresets": [
    {
      "name": "simulation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/simulation",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "simulation",
      "configurePreset": "simulation"
    }
  ],
  "testPresets": [
    {
      "name": "simulation",
      "configurePreset": "simulation",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
